#!/usr/bin/env ruby

def cwd
  @cwd ||= __dir__
end

def root
  File.dirname(cwd)
end

def home
  @home ||= File.expand_path("~")
end

def install(file)
  source = "#{root}/#{file}"
  return puts "no source at #{source}" unless File.exist?(source)

  if system("ln", "-nsf", source, "#{home}/#{file}")
    print "successfully installed "
  else
    print "failed to install "
  end
  puts file
end

def uninstall(file)
  file = File.join(home, file)
  return puts "no file at #{file}" unless File.exist?(file)
  if File.symlink?(file)
    File.unlink(file)
    puts "removed symlink at #{file}"
  else
    puts "could not remove non-symlink at #{file}"
  end
end

def uninstall?
  ARGV.include?("-u")
end

if ARGV.include?("-h")
  script = File.basename(__FILE__)
  puts %(
  "#{script}" symlinks the files in dotfiles into your home directory.
  options:
      -h  Get this help
      -u  Remove symlinks to files in dotfiles
  )
  exit 0
end

# Dotfiles to symlink into $HOME. Add new dotfiles here; repo tooling and dev
# artifacts stay out of $HOME simply by being omitted from this list.
INSTALL = %w[
  .bash_aliases .bash_functions .bash_profile .bashrc
  .ctags .gemrc
  .gitconfig .gitignore
  .vim .vimrc
  .zshrc
]

INSTALL.each do |file|
  uninstall? ? uninstall(file) : install(file)
end
