#!/usr/bin/env ruby

def cwd
  @cwd ||= __dir__
end

def root
  File.dirname(cwd)
end

def home
  @home ||= File.expand_path("~")
end

def install(file)
  if system("ln", "-nsf", "#{root}/#{file}", "#{home}/#{file}")
    print "successfully installed "
  else
    print "failed to install "
  end
  puts file
end

def uninstall(file)
  file = File.join(home, file)
  return puts "no file at #{file}" unless File.exist?(file)
  if File.symlink?(file)
    File.unlink(file)
    puts "removed symlink at #{file}"
  else
    puts "could not remove non-symlink at #{file}"
  end
end

def uninstall?
  ARGV.include?("-u")
end

if ARGV.include?("-h")
  script = File.basename(__FILE__)
  puts %(
  "#{script}" symlinks the files in dotfiles into your home directory.
  options:
      -h  Get this help
      -u  Remove symlinks to files in dotfiles
  )
  exit 0
end

# Repo-tooling and dev artifacts that live here but must not be symlinked into $HOME.
IGNORE = %w[
  bin . .. .git .github .venv .bundle
  .editorconfig .shellcheckrc .vintrc.yaml .standard.yml .pre-commit-config.yaml
  .ruby-version Gemfile Gemfile.lock pyproject.toml uv.lock README.md
]

(Dir.entries(root) - IGNORE).each do |file|
  next if /(~|.*\.swp)$/.match?(file)
  uninstall? ? uninstall(file) : install(file)
end
